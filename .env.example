# Copie este arquivo para .env e substitua os valores demonstrativos.
# O arquivo .env efetivo é local, contém credenciais e não deve ser versionado.
APP_ENV=development

# O Compose reutiliza estas três variáveis para criar o usuário do MySQL e montar
# a DATABASE_URL interna com o host mysql e a porta 3306. Mantenha os valores
# coerentes e, neste fluxo, use somente letras, números e sublinhado nas
# credenciais para não introduzir caracteres reservados na URL.
MYSQL_DATABASE=rota_fluminense
MYSQL_USER=usuario_exemplo
MYSQL_PASSWORD=senha_exemplo

# Solicita ao MySQL uma senha aleatória para root; não defina senha de root aqui.
MYSQL_RANDOM_ROOT_PASSWORD=yes

# Usada somente pelo override opcional que publica o MySQL no loopback do host.
MYSQL_HOST_PORT=3306

# Usada por API, Alembic e seed quando executados nativamente no host. Repita o
# usuário, a senha, o banco e a porta definidos acima. Se optar por caracteres
# reservados nesse modo, aplique percent-encoding à URL. A pilha completa ignora
# este valor e monta sua própria URL interna apontando para mysql:3306.
DATABASE_URL=mysql+pymysql://usuario_exemplo:senha_exemplo@127.0.0.1:3306/rota_fluminense

# Lista de origens HTTP/HTTPS explícitas, separadas por vírgula e sem caminho.
# Curinga, origem null, credenciais embutidas, consulta e fragmento são rejeitados.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Configuração da integração externa, em segundos.
OPEN_METEO_TIMEOUT_SECONDS=5
OPEN_METEO_CACHE_TTL_SECONDS=1800
